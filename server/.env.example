# 服务器配置
PORT=3000
# 对外可访问的服务基础地址（用于 mock 支付链接等需要返回给客户端的地址）
# SERVER_PUBLIC_BASE_URL=http://192.168.1.20:3000
# 启动日志中的局域网访问地址（多网卡环境建议显式配置）
# SERVER_LAN_HOST=192.168.1.20
# Swagger 文档默认关闭，按需开启
# ENABLE_SWAGGER=false

# 环境配置（development=开发环境自动同步数据库，production=生产环境）
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=pet_hospitals

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
# JWT_EXPIRATION=7d  # Token 已设置为永不过期，此配置已废弃

# AI 问诊配置
AI_CONSULTATION_API_URL=https://api.example.com/ai
AI_CONSULTATION_API_KEY=your_api_key_here

# 文件上传临时目录（文件持久化到 COS 后会自动清理）
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=838860800  # 800MB (支持大视频上传)

# 腾讯云对象存储 COS（仅在服务端配置密钥，禁止提交真实值）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=gdcw-1386217335
COS_REGION=ap-chengdu

# 腾讯云短信配置
SMS_SECRET_ID=your_secret_id
SMS_SECRET_KEY=your_secret_key
SMS_APP_ID=your_app_id
# 需填写腾讯云“已审核通过”的签名名称（不要带【】）
SMS_SIGN_NAME=your_sms_sign_name
SMS_TEMPLATE_REGISTER=your_register_template_id
SMS_TEMPLATE_RESET_PASSWORD=your_reset_password_template_id
SMS_TEMPLATE_LOGIN=your_login_template_id
SMS_REGION=ap-guangzhou
# 超级验证码（默认值也是 000000），命中后直接视为校验通过
SMS_SUPER_CODE=000000

# ========== 支付配置 ==========

# 支付宝配置
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
# 证书模式需同时配置以下三个绝对路径；三者都不配置时回退为公钥模式
ALIPAY_APP_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
# 必须与支付宝商家平台已申报的转账场景名称完全一致，例如：业务结算
ALIPAY_TRANSFER_SCENE_NAME=
# “业务结算”场景的固定信息类型与本项目款项描述
ALIPAY_TRANSFER_SCENE_REPORT_INFO_TYPE=结算款项名称
ALIPAY_TRANSFER_SCENE_REPORT_INFO_CONTENT=二手商品销售货款
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://yourdomain.com/payment/callback/alipay
ALIPAY_RETURN_URL=https://yourdomain.com/payment/return/alipay

# 微信支付配置
WECHAT_PAY_APP_ID=your_wechat_app_id
WECHAT_PAY_MCH_ID=your_merchant_id
WECHAT_PAY_API_KEY=your_wechat_api_key
WECHAT_PAY_APICLIENT_KEY=path_to_apiclient_key.pem
WECHAT_PAY_APICLIENT_CERT=path_to_apiclient_cert.pem
WECHAT_PAY_SERIAL_NO=your_certificate_serial_no
WECHAT_PAY_NOTIFY_URL=https://yourdomain.com/payment/callback/wechat
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
