# 验收环境必须使用独立数据库和独立 Redis DB，禁止填写生产库名称。
NODE_ENV=acceptance
PORT=3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=pet_acceptance
DB_PASSWORD=replace_with_acceptance_password
DB_DATABASE=pet_hospitals_acceptance
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=8
ENABLE_SWAGGER=true
SERVER_PUBLIC_BASE_URL=http://127.0.0.1:3100
