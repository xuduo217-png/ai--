# 环境
VITE_NODE_ENV=production

# 接口前缀 - 后端服务器地址
VITE_API_BASE_PATH=http://localhost:3000

# 静态资源前缀（留空时回退到当前访问 origin）
# VITE_STATIC_BASE_PATH=http://127.0.0.1:3000
VITE_STATIC_BASE_PATH=https://gdcw-1386217335.cos.ap-chengdu.myqcloud.com

# 后端 API 地址
VITE_SERVER_API_BASE_URL=/server-api

# Vite 开发代理目标（跨设备联调时请改成可达地址）
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_SERVER_API_PROXY_TARGET=http://127.0.0.1:3000

VITE_API_PROXY_TARGET=https://gudeapi.zuoyongyoubao.com
VITE_SERVER_API_PROXY_TARGET=https://gudeapi.zuoyongyoubao.com


# 打包路径
VITE_BASE_PATH=/dist-dev/

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=true

# 输出路径
VITE_OUT_DIR=dist-dev

# 标题
VITE_APP_TITLE=ElementAdmin

# 是否包分析
VITE_USE_BUNDLE_ANALYZER=false

# 是否全量引入element-plus样式
VITE_USE_ALL_ELEMENT_PLUS_STYLE=false

# 是否开启mock - 关闭 mock 以使用真实后端 API
VITE_USE_MOCK=false

# 是否切割css
VITE_USE_CSS_SPLIT=true

# 是否使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=false
