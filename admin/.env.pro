# 环境
VITE_NODE_ENV=production

# 接口前缀 - 后端服务器完整地址
VITE_API_BASE_PATH=https://gudeapi.zuoyongyoubao.com

# 静态资源前缀
VITE_STATIC_BASE_PATH=https://gdcw-1386217335.cos.ap-chengdu.myqcloud.com

# 后端 API 地址
VITE_SERVER_API_BASE_URL=https://gudeapi.zuoyongyoubao.com

# Vite 开发代理目标（生产构建不使用，仅保留统一变量）
VITE_API_PROXY_TARGET=https://gudeapi.zuoyongyoubao.com
VITE_SERVER_API_PROXY_TARGET=https://gudeapi.zuoyongyoubao.com

# 打包路径
VITE_BASE_PATH=/

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 输出路径
VITE_OUT_DIR=dist-pro

# 标题
VITE_APP_TITLE=谷德E宠物

# 是否包分析
VITE_USE_BUNDLE_ANALYZER=true

# 是否全量引入element-plus样式
VITE_USE_ALL_ELEMENT_PLUS_STYLE=false

# 是否开启mock
VITE_USE_MOCK=false

# 是否切割css
VITE_USE_CSS_SPLIT=true

# 是否使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=true
