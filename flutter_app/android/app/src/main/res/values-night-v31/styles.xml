<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the branded splash background in dark mode as well. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0062FB</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:statusBarColor">#0062FB</item>
        <item name="android:navigationBarColor">#0062FB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
